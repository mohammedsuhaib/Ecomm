# town-basket.com now belongs to the shop: every URL 301s to
# shop.town-basket.com, path and query kept. The exception is the published
# policy pages (and the files they load), which stay served here because they
# are cited by URL outside our control — the storefront footer, the Play Store
# listing's privacy URL, and the Razorpay KYC review. Redirecting those would
# land on storefront 404s.

(security_headers) {
	header {
		# Force HTTPS for a year, including subdomains
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Stop MIME-type sniffing
		X-Content-Type-Options "nosniff"
		# Disallow framing (clickjacking protection)
		X-Frame-Options "DENY"
		# Limit referrer leakage
		Referrer-Policy "strict-origin-when-cross-origin"
		# Static site: only load resources from our own origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Disable powerful browser features we don't use
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Don't advertise the server software
		-Server
	}
}

town-basket.com {
	encode gzip zstd
	root * /srv
	import security_headers

	# Correct MIME for the PWA manifest (alpine's mime db may not know it)
	@manifest path /manifest.webmanifest
	header @manifest Content-Type application/manifest+json

	# An allowlist, so nothing else in the mounted folder (README, deploy/) is
	# reachable. index.html is deliberately absent: the pages' own "home" link
	# should take people to the shop.
	@kept path /terms.html /privacy.html /refund.html /shipping.html /contact.html /styles.css /sw.js /sw-register.js /install.js /manifest.webmanifest /icons/*
	handle @kept {
		file_server
	}
	handle {
		redir https://shop.town-basket.com{uri} permanent
	}
}

www.town-basket.com {
	import security_headers

	@policy path /terms.html /privacy.html /refund.html /shipping.html /contact.html
	handle @policy {
		redir https://town-basket.com{uri} permanent
	}
	handle {
		redir https://shop.town-basket.com{uri} permanent
	}
}

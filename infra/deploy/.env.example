# Production secrets template. Copy to `.env` on the droplet (chmod 600) and
# fill in real values. NEVER commit the real .env.
#
# REQUIRED by docker-compose.prod.yml — REGISTRY, DB_URL, DB_USERNAME,
# DB_PASSWORD, JWT_SECRET, FIREBASE_PROJECT_ID. Each is guarded with
# ${VAR:?...}, so a missing OR blank value stops `compose up` naming the var
# instead of booting a half-configured stack.
#
# REQUIRED by backup/nightly-backup.sh — DB_URL_PG, SPACES_BUCKET,
# SPACES_ENDPOINT (+ AWS credentials for the Spaces key). That script carries
# its own :? guards; the API stack runs fine without them.
#
# Everything else is either optional at runtime (the compose file documents each
# default) or a BUILD-time value that never reaches the running container.

# Container registry the prod images are pulled from. CI (the "Deploy app"
# workflow) builds and pushes to GHCR and deploys pinned per-commit sha tags;
# it overrides REGISTRY/TAG via the environment, so these values only matter
# for MANUAL compose operations on the droplet. `latest` is also pushed on
# every deploy, so a manual pull gets the newest images. Manual pulls need a
# `docker login ghcr.io` with a PAT that has read:packages (the CI login is
# job-scoped and expires).
REGISTRY=ghcr.io/mohammedsuhaib
TAG=latest

# Database (recommended: DO Managed Postgres)
DB_URL=jdbc:postgresql://db-host:25060/townbasket?sslmode=require
DB_USERNAME=townbasket
DB_PASSWORD=change-me

# Backups → DO Spaces (s3-compatible)
DB_URL_PG=postgres://townbasket:change-me@db-host:25060/townbasket?sslmode=require
SPACES_BUCKET=town-basket-backups
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RETENTION_DAYS=30

# Auth (M4): app-issued JWT signing key — MUST be >= 32 bytes, random, secret.
JWT_SECRET=change-me-to-a-long-random-32-byte-minimum-secret

# Payment gateway — NOT WIRED YET. No code reads these and compose does not pass
# them; the only UPI provider is still a fake that auto-succeeds (hence
# UPI_ENABLED=false below). They stay here to reserve the slot for the
# Paytm->Razorpay decision.
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=

# Firebase phone-OTP (M4). Backend verifier: set to your Firebase projectId to
# enable real OTP (disables the offline dev fake). Blank is NOT a downgrade to
# the fake — compose rejects it up front, and the API itself refuses to boot on a
# blank project-id with a message naming this property. To run the offline fake
# deliberately, comment out TOWNBASKET_IDENTITY_FIREBASE_PROJECT_ID in
# docker-compose.prod.yml (leaving this var set does nothing on its own).
FIREBASE_PROJECT_ID=town-basket

# ---- Optional runtime vars (compose supplies a documented default) ---------

# Browser origins allowed to call the API. Defaults to the three prod hosts in
# the Caddyfile; override only if you add a domain.
# APP_CORS_ALLOWED_ORIGINS=https://shop.town-basket.com,https://admin.town-basket.com,https://delivery.town-basket.com

# Web Push for order notifications. Leave unset to keep the channel off (the
# apps fall back to in-app SSE). Generate once:
#   npx web-push generate-vapid-keys
# WEB_PUSH_PRIVATE_KEY is a SECRET — it belongs here, never in git.
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:support@town-basket.com

# Online UPI. MUST stay false until a real gateway replaces the fake provider —
# the fake auto-succeeds and would mark orders PAID with no money received.
# UPI_ENABLED=false

# ---- Per-container memory limits -------------------------------------------
# Six containers share one droplet, so each has a ceiling (see the budget note
# at the top of docker-compose.prod.yml). The defaults below total ~3.1 GB and
# assume the planned 4 GB droplet; LOWER THEM ALL on a 2 GB box.
#
# API_MEM_LIMIT also sizes the JVM heap: the image takes 70% of this limit as
# max heap, so this one value tunes both. Raise it before anything else if the
# API is the container under pressure.
# API_MEM_LIMIT=1500m
# STOREFRONT_MEM_LIMIT=512m
# ADMIN_MEM_LIMIT=384m
# DELIVERY_MEM_LIMIT=384m
# CADDY_MEM_LIMIT=128m
# ALLOY_MEM_LIMIT=256m

# ---- Auth abuse limits -----------------------------------------------------
# Two layers, both in-memory (single instance, no Redis):
#
# 1. Per client IP, per auth endpoint, per 60s. An IP is NOT a person — a shop's
#    WiFi or a mobile carrier's CGNAT pool puts a whole group of customers on one
#    address — so this has to fit a crowd signing in together, not one user.
#    Raise it if real customers ever see "Too many requests" on login.
# TOWNBASKET_RATELIMIT_CAPACITY=60
#
# 2. Per staff ACCOUNT: failed password attempts allowed within the window. This
#    is what bounds password guessing (sharing an IP is irrelevant to it). Only
#    FAILURES count and a correct password clears the count, so staff logging in
#    normally never consume it. Tighten for a stricter lockout; loosen if staff
#    lock themselves out legitimately.
# TOWNBASKET_LOGIN_THROTTLE_MAX_FAILURES=10
# TOWNBASKET_LOGIN_THROTTLE_WINDOW=PT5M

# ---- Public identity / SEO (storefront, runtime) ---------------------------
# The ONE hostname the shop answers on. Canonical tags, Open Graph URLs,
# robots.txt and sitemap.xml are all built from it, so it must be the address
# you want people and search engines to use — and every other host that serves
# the shop should redirect to it permanently. Two hostnames serving the same
# catalogue splits the site in search, and a domain that serves a "coming soon"
# page while the shop lives elsewhere is the same problem in a worse form.
SITE_URL=https://town-basket.com

# Set to true on anything that is not the real shop (staging, a preview host).
# robots.txt then answers "Disallow: /", the sitemap comes back empty and every
# page carries a noindex tag. QA sets this in its own compose file.
# SEO_NOINDEX=false

# ---- BUILD args (inert at runtime) ----------------------------------------
# Next.js inlines every NEXT_PUBLIC_* value at IMAGE BUILD time, so these must be
# passed with --build-arg when CI builds the frontend images. Setting them in the
# running container's environment does nothing — in the browser OR during SSR.
# All three frontends need the API base URL:
NEXT_PUBLIC_API_BASE_URL=https://api.town-basket.com/api/v1

# Firebase Web config (storefront only). Safe to expose in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCeGmac68Mffr_hEKyMaodqHpI2afehRso
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=town-basket.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=town-basket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=town-basket.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=661494495950
NEXT_PUBLIC_FIREBASE_APP_ID=1:661494495950:web:e554decc5ee8f8c92e2e9f

# Google Maps (storefront address pin-drop). Public BROWSER key, inlined at build
# time. The security control is the HTTP-referrer restriction — lock the key in
# Google Cloud to your domains (https://shop.town-basket.com/* is where the
# storefront actually runs; https://*.town-basket.com/* covers qa too, plus
# http://localhost:3000/* for dev) + restrict it to the "Maps JavaScript API".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBT7nnGEdDd9y66tZCF2Ajv9QriIduxpuA


# ---- Log shipping to Grafana Cloud (optional) ------------------------------
# A small Alloy agent ships EVERY container's logs (api, storefront, admin,
# delivery, caddy, postgres) to Grafana Cloud Loki, where you view and search
# them in a browser — and they survive the droplet. OFF by default.
#
# To turn it on, set the profile line AND all three GRAFANA_LOKI_* values, then
# redeploy. Every future `docker compose up -d` starts the agent automatically.
# COMPOSE_PROFILES=monitoring
#
# From a free Grafana Cloud account -> Connections -> add "Hosted logs" (Loki):
#   - URL   : the push endpoint, e.g. https://logs-prod-012.grafana.net/loki/api/v1/push
#   - USER  : the numeric instance / user id it shows as the username
#   - TOKEN : an access token / API key scoped logs:write (this is the password)
# The token is a SECRET — it belongs here in .env, never in git.
# GRAFANA_LOKI_URL=
# GRAFANA_LOKI_USER=
# GRAFANA_LOKI_TOKEN=

# Product image uploads -> DO Spaces. Leave unset to keep upload OFF (the admin
# form falls back to pasting an image URL, and the seeded catalogue keeps
# serving photos from the storefront bundle).
#
# Use a SEPARATE bucket from SPACES_BUCKET above: these objects are made
# world-readable so the storefront can load them with no credentials, and the
# database backups must never share that access policy.
#
# In the DigitalOcean console: Spaces -> Create a Space (same region as the
# droplet) -> then API -> Spaces Keys -> Generate New Key.
#
# PUBLIC_BASE_URL is where those objects are readable from — the Space's own
# origin, or its CDN alias if you enable the CDN. It is also what decides later
# whether an image belongs to us and may be deleted with its product, so
# changing it orphans every image already stored under the old value.
# CATALOG_IMAGES_SECRET_KEY is a SECRET — it belongs here, never in git.
# CATALOG_IMAGES_BUCKET=town-basket-media
# CATALOG_IMAGES_ENDPOINT=https://blr1.digitaloceanspaces.com
# CATALOG_IMAGES_REGION=blr1
# CATALOG_IMAGES_PUBLIC_BASE_URL=https://town-basket-media.blr1.cdn.digitaloceanspaces.com
# CATALOG_IMAGES_ACCESS_KEY=
# CATALOG_IMAGES_SECRET_KEY=

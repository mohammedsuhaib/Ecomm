# QA environment reverse proxy — auto-TLS on the qa-* subdomains.
#
# No HTTP-layer gate: every host is proxied straight through, exactly as
# production's infra/deploy/Caddyfile does. QA's request path is therefore
# byte-identical to production's, which is what lets QA validate the one thing
# it could never validate behind a basic-auth gate — that the apps install and
# update as PWAs. The apps protect themselves the same way production does
# (JWT roles), and all QA hosts send X-Robots-Tag so search engines never
# index the test site.
#
# QA still runs the FAKE phone verifier (any 10-digit phone logs in), so
# reaching these hosts must be restricted BELOW HTTP — on the tailnet, per
# ACCESS-MIGRATION.md. Do not re-add a gate here; fix the network layer.

(qa_common) {
	encode gzip zstd
	header X-Robots-Tag "noindex, nofollow"
}

qa.town-basket.com {
	import qa_common
	reverse_proxy storefront:3000
}

qa-admin.town-basket.com {
	import qa_common
	reverse_proxy admin:3001
}

qa-delivery.town-basket.com {
	import qa_common
	reverse_proxy delivery:3002
}

qa-api.town-basket.com {
	import qa_common
	# SSE (live order tracking + admin queue) needs unbuffered responses.
	reverse_proxy api:8080 {
		flush_interval -1
	}
}

// Grafana Alloy — ship every Docker container's logs to Grafana Cloud Loki.
//
// Shared by the QA and prod stacks (infra/qa + infra/deploy). The agent runs
// ON the droplet but STORES nothing there: it streams logs out to hosted Loki,
// so they survive the container — and the droplet — dying. Outbound HTTPS only;
// it needs no inbound port.
//
// Three things come from the environment (set in the stack's .env, never here):
//   GRAFANA_LOKI_URL    the Grafana Cloud Loki push endpoint (…/loki/api/v1/push)
//   GRAFANA_LOKI_USER   the numeric instance/user id (basic-auth username)
//   GRAFANA_LOKI_TOKEN  an API token with logs:write scope (basic-auth password)
// plus TB_ENV ("qa" or "prod"), set per stack so you can tell them apart in one
// Grafana with {env="qa"} vs {env="prod"}.

// Discover the containers Compose is running on this host.
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

// Keep only labels worth querying on: the Compose SERVICE (api, storefront,
// admin, delivery, caddy, postgres) and the CONTAINER name. High-cardinality
// Docker metadata is dropped so it never becomes a Loki label.
discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

// Read each discovered container's log stream and forward it on, stamped with
// which environment this is.
loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	labels     = {env = sys.env("TB_ENV")}
	forward_to = [loki.process.levels.receiver]
}

// Lift the API's log level into a label.
//
// {service="api", level="ERROR"} is a different thing from |= "ERROR", which
// also matches the word inside a message and misses nothing-matching lines of
// a wall of output. Five possible values, so the label stays cheap — the rule
// for Loki is that labels are for things with few values, and everything else
// belongs in the line.
//
// Scoped to the API on purpose: the other containers log in their own shapes
// (Caddy emits one JSON object per line, Next.js free text) and a rule written
// for Spring Boot's pattern would either miss or mislabel them. They pass
// through untouched.
//
// NOTE: a Java stack trace still arrives as one Loki entry PER LINE. Alloy's
// stage.multiline does not join lines coming from loki.source.docker — tried
// against a real Loki, both nested in this match and hoisted to its own
// pipeline, and neither joined anything. Rather than leave a rule here that
// looks like it works, the honest fix is at the source: make the app emit one
// line per event (structured JSON logging). Until then use Grafana's "show
// context" on the ERROR line to read the frames around it.
loki.process "levels" {
	forward_to = [loki.write.grafana_cloud.receiver]

	stage.match {
		selector = "{service=\"api\"}"

		stage.regex {
			expression = "^\\S+\\s+(?P<level>TRACE|DEBUG|INFO|WARN|ERROR)\\s"
		}

		stage.labels {
			values = {level = ""}
		}
	}
}

// Push to Grafana Cloud. If the three vars are blank (profile enabled but not
// configured) the agent starts and logs an auth error here — visible in
// `docker compose logs alloy` — rather than failing silently.
loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_LOKI_USER")
			password = sys.env("GRAFANA_LOKI_TOKEN")
		}
	}
}
